# BASIC SETTINGS
# ================================

set drawbox true
set borderstyle roundbox
set mouse true
set ratios 1:1
set icons true
set mergeindicators true
set terminalcursor bar
set filtermethod glob
set searchmethod glob
set dupfilefmt "%b (%n)%e"
set dirpreviews true
set cursorpreviewfmt "\033[7m"
set watch true
set hiddenfiles ".*:lost+found:*.bak:__pycache__"
set info time:size
set previewer ~/.config/lf/previewer
set cleaner ~/.config/lf/cleaner

# MAPPINGS
# ================================

map d
map dd cut
map dT trash
map dD delete

map <enter>
map <enter> open

map <c-h>
map <c-h> set hidden!

map r
map r :rename; cmd-end
map a rename

map R
map R reload

map ,
map ,dl  cd ~/Downloads
map ,doc cd ~/Documents
map ,dot cd ~/dotfiles
map ,pic cd ~/Pictures
map ,wa  cd ~/Documents/Work/Ambientes
map ,wb  cd ~/Documents/Work/Backend
map ,lf edit-config

map i $bat --color=always --style=numbers --wrap=never --paging=always -- "$f"

map O push :open-with-gui<space>
map o push :open-with-cli<space>

map t
map th &herdr pane split --current --direction right --cwd "$PWD" --focus
map tv &herdr pane split --current --direction down --cwd "$PWD" --focus

map y
map yy copy
map yp yank-path
map yn yank-name
map p : paste; clear

# CUSTOM FUNCTIONS
# ================================

# https://github.com/gokcehan/lf/wiki/Ranger#file-opener-rifle
cmd open $set -f; rifle -p 0 "$fx"

cmd edit-config ${{
    $EDITOR ~/.config/lf/lfrc
    lf -remote "send $id source ~/.config/lf/lfrc"
}}

cmd mkdir %{{
    IFS=" "
    mkdir -p -- "$*"
    lf -remote "send $id select \"$*\""
}}

cmd bulk-rename ${{
    old="$(mktemp)"
    new="$(mktemp)"
    if [ -n "$fs" ]; then
        fs="$(basename -a $fs)"
    else
        fs="$(ls)"
    fi
    printf '%s\n' "$fs" >"$old"
    printf '%s\n' "$fs" >"$new"
    $EDITOR "$new"
    [ "$(wc -l < "$new")" -ne "$(wc -l < "$old")" ] && exit
    paste "$old" "$new" | while IFS= read -r names; do
        src="$(printf '%s' "$names" | cut -f1)"
        dst="$(printf '%s' "$names" | cut -f2)"
        if [ "$src" = "$dst" ] || [ -e "$dst" ]; then
            continue
        fi
        mv -- "$src" "$dst"
    done
    rm -- "$old" "$new"
    lf -remote "send $id unselect"
}}

cmd touch %touch "$@"

cmd yank-path $printf '%s' "$fx" | wl-copy
cmd yank-name $basename -a -- $fx | head -c-1 | wl-copy
