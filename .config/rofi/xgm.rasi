@import "colors.rasinc"
@import "input_bar.rasinc"
@import "list_view.rasinc"

configuration {
    modi: "drun,run,window,ssh";
    font: "JetBrains Mono Nerd Font 13";

    show-icons: true;

    display-ssh: "";
    display-run: "";
    display-drun: "";
    display-window: "";
    display-calc: "";
    display-emoji: "📔";

    window-format: "{c} · {t}";
    drun-display-format: "{name}";

    case-smart: true;
    disable-history: false;
    parse-known-hosts: false;
}

window {
    background-color: @bg;
    border: 1px solid;
    border-color: @fga;
    border-radius: 0px;
    width: 600px;
}

mainbox {
    background-color: @al;
    children: ["inputbar", "listview", "message"];
    spacing: 6px;
    padding: 6px;
}

message {
    padding: 7px 9px;
    background-color: @bga;
    border-radius: 7px;
}

textbox {
    background-color: @bga;
}
