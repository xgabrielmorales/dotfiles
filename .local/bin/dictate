#!/usr/bin/env bash

set -euo pipefail

AUDIO_FILE="/tmp/dictate.wav"

exec 9>/tmp/dictate.lock
flock --nonblock 9 || exit 0

notify-send \
    --icon="audio-input-microphone" \
    --expire-time=3000 \
    "Dictate" \
    "Recording..."

# timeout exits 124 when the limit is reached
timeout --signal=INT 3 pw-record \
    --channels=1 \
    --rate=16000 \
    --format=s16 \
    "$AUDIO_FILE" >/dev/null 2>&1 || true

notify-send \
    --icon="text-x-generic" \
    --expire-time=2000 \
    "Dictate" \
    "Transcribing..."

curl --silent --fail \
    --form file=@"$AUDIO_FILE" \
    --form response_format=text \
    http://127.0.0.1:8642/inference |
    tr '\n' ' ' |
    sed -e 's/^ *//' -e 's/ *$//' |
    wtype -
