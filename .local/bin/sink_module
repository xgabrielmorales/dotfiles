#!/usr/bin/env bash

SINK_ICON=""
SINK_MUTE_ICON=""

sink_volume() {
    local status
    local volume

    status=$(pamixer --get-mute)
    [[ "$status" == true ]] && echo "-1" && return 0

    volume=$(pamixer --get-volume)
    echo "$volume"
}

sink_status() {
    local volume

    volume="$1"

    if (( volume <= -1 )); then
        echo "$SINK_MUTE_ICON MUTE"
    else
        echo "$SINK_ICON $volume%"
    fi
}

sink_notify() {
    local volume

    volume="$(sink_volume)"

    local id_file="${XDG_RUNTIME_DIR:-/tmp}/sink_module.nid"
    local id

    id=$(cat "$id_file" 2>/dev/null)

    notify-send -a sink_module -p -r "${id:-0}" \
        -h "int:value:$(( volume < 0 ? 0 : volume ))" \
        "" > "$id_file"
}

case "$1" in
    "--status")
        sink_status "$(sink_volume)"
    ;;
    "--toggle")
        pamixer --toggle-mute
        sink_notify
    ;;
    "--inc")
        pamixer --increase 5
        sink_notify
    ;;
    "--dec")
        pamixer --decrease 5
        sink_notify
    ;;
esac
